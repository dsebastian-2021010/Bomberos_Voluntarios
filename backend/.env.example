# Servidor
PORT=3000
NODE_ENV=development

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=cambia_esta_contraseña
DB_NAME=bomberos_db

# JWT
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
JWT_EXPIRY=15m
JWT_REFRESH_SECRET=cambia_este_refresh_secret_por_uno_largo_y_aleatorio
JWT_REFRESH_EXPIRY=7d

# Email SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASSWORD=tu_app_password
SMTP_FROM_NAME=Bomberos Voluntarios
SMTP_FROM_EMAIL=noreply@bomberos.local
ADMIN_EMAILS=admin1@ejemplo.com,admin2@ejemplo.com

# Integración con la central de llamadas (sistema externo, aún por conectar)
# Mientras EXTERNAL_BLOCKLIST_ENABLED no sea "true", el sistema solo registra
# en el log qué habría bloqueado, sin fallar. Ver
# backend/src/services/externalBlocklistService.ts para implementar la
# conexión real cuando se tengan estos datos.
EXTERNAL_BLOCKLIST_ENABLED=false
EXTERNAL_DB_HOST=
EXTERNAL_DB_PORT=
EXTERNAL_DB_USER=
EXTERNAL_DB_PASSWORD=
EXTERNAL_DB_NAME=
EXTERNAL_DB_TABLA=
EXTERNAL_DB_COLUMNA_TELEFONO=
EXTERNAL_DB_COLUMNA_BLOQUEADO_HASTA=

# SuperAdmin inicial (usado por el script de seed)
SUPERADMIN_NOMBRE=Administrador General
SUPERADMIN_EMAIL=superadmin@bomberos.local
SUPERADMIN_PASSWORD=CambiaEsto123!

# Frontend
FRONTEND_URL=http://localhost:5173
